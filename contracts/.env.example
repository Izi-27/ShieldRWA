# Deployer key for X Layer testnet. Use a dedicated key holding only testnet gas.
DEPLOYER_PRIVATE_KEY=0x...

# X Layer testnet RPC.
XLAYER_RPC_URL=https://testrpc.xlayer.tech

# Address granted GUARDIAN_ROLE (execution) and REPORTER_ROLE (risk anchoring).
# This is the backend's signer — set it to the address derived from the
# server's GUARDIAN_PRIVATE_KEY. Defaults to the deployer when unset.
# GUARDIAN_ADDRESS=0x...

# Reuse existing tokens / venue instead of deploying mocks.
# RWA_TOKEN_ADDRESS=0x...
# DEFENSIVE_TOKEN_ADDRESS=0x...
# DEX_ROUTER_ADDRESS=0x...
