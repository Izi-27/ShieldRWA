# ---------------------------------------------------------------- service
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

DATABASE_PATH=./data/shieldrwa.db

# Must be a strong random value in production (32+ chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-in-production!!
JWT_TTL_SECONDS=43200
SIWE_NONCE_TTL_SECONDS=300

# ------------------------------------------------------------------ chain
# Leave CHAIN_RPC_URL unset to run without a chain: risk scoring and the AI
# layer still work, and protective actions are recorded as "simulated".
CHAIN_RPC_URL=https://testrpc.xlayer.tech
CHAIN_ID=1952
CHAIN_NAME=X Layer Testnet
CHAIN_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer-test

# Written by `npm run deploy:xlayer` in ../contracts. Explicit addresses below
# override whatever the address book contains.
DEPLOYMENT_FILE=../contracts/deployments/xlayerTestnet.json
# RWA_POSITION_ADDRESS=0x...
# RISK_ORACLE_ADDRESS=0x...
# PROTECTION_EXECUTOR_ADDRESS=0x...
# DEX_ROUTER_ADDRESS=0x...
# RWA_TOKEN_ADDRESS=0x...
# DEFENSIVE_TOKEN_ADDRESS=0x...

# Backend signer holding GUARDIAN_ROLE and REPORTER_ROLE. Without it the server
# reads the chain but never writes — no anchoring, no execution.
# Use a dedicated key that holds only testnet gas.
# GUARDIAN_PRIVATE_KEY=0x...

# --------------------------------------------------------------------- AI
# Which provider drives the AI Risk Analyst and AI Risk Guardian.
# Without a working credential both fall back to their deterministic
# implementations and label their output source: "deterministic".
AI_PROVIDER=gemini

# --- Google Gemini (default) ---
# Key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# gemini-3.7-flash  - latest stable Flash; fast and cheap, good for a 5s cycle
# gemini-3.1-pro-preview - flagship reasoning, slower and pricier
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic (set AI_PROVIDER=anthropic to use) ---
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# Optional: route through an Anthropic-compatible gateway. The endpoint must
# speak the Messages API and pass `thinking` and `output_config` through
# untouched. Gateways built for coding tools may reject a plain SDK client.
# ANTHROPIC_BASE_URL=https://gateway.example.com
# Gateways authenticating with `Authorization: Bearer` use this instead of
# ANTHROPIC_API_KEY. Setting both is rejected at boot.
# ANTHROPIC_AUTH_TOKEN=

# Reasoning depth. Maps to Gemini's thinking_level (low/medium/high) and to
# Anthropic's effort ladder. Verify any change with `npm run verify:ai`.
# Hard ceiling on AI requests per minute across ALL positions. Sized to the
# provider free tier; exceeding it just wastes a 429. 0 disables.
AI_MAX_RPM=4
# Re-narrate at most this often, or sooner on a band change / score move.
AI_MIN_INTERVAL_MS=90000
AI_CHANGE_THRESHOLD=8

AI_EFFORT=medium
AI_TIMEOUT_MS=45000

# ------------------------------------------------------------ market data
# coingecko = real public price feed; simulated = seeded local walk.
MARKET_DATA_PROVIDER=coingecko
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Free demo-plan key from https://www.coingecko.com/en/developers/dashboard
# Optional locally; effectively required on shared hosting, where the
# keyless per-IP quota is shared with every other tenant on the node.
COINGECKO_API_KEY=
MARKET_REFERENCE_ASSET=ethereum
# One upstream read shared across positions for this long, to stay inside the
# free CoinGecko rate limit.
MARKET_CACHE_MS=20000

# ---------------------------------------------------------- risk pipeline
RISK_CYCLE_MS=5000
RISK_ANCHOR_INTERVAL_MS=60000
PREDICTION_HORIZON_HOURS=6
